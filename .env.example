# Server Port (defaults to 3000)
PORT=3000

# Optional server-level Last.fm API Key (obtain from https://www.last.fm/api/account/create)
LASTFM_API_KEY=""

# Optional server-level Last.fm API Secret
LASTFM_API_SECRET=""

# Persistent journal (Node 22.13+ required). Mount this directory on persistent storage.
ACTIVITY_DB_PATH="data/activity.sqlite"
ACTIVITY_RETENTION_DAYS=90
